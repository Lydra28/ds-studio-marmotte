---
import Base from '../layouts/Base.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { DOWNLOADS, INSTALLERS } from '../lib/site';

// Lot 5 du site : un système par colonne (filets, logo pixel), puis les
// étapes après l'installation.
---

<Base title="Télécharger" description="Télécharge DS-Studio pour Windows, macOS ou Linux.">
  <div class="page-head">
    <h1>Télécharger DS-Studio</h1>
    <p class="lead">Toujours la dernière version publiée. L’app se met ensuite à jour toute seule (Windows et Linux).</p>
  </div>
  <div class="os-cols">
    {
      INSTALLERS.map((i) => (
        <section class="os-col" aria-labelledby={`os-${i.icon}`}>
          <span class="os-icon">
            <PixelIcon name={i.icon} scale={3} />
          </span>
          <h2 id={`os-${i.icon}`}>{i.os}</h2>
          <p class="muted">{i.detail}</p>
          <a class="button primary" href={`${DOWNLOADS}/${i.file}`} download>
            Télécharger pour {i.os}
          </a>
          <h3>Premier lancement</h3>
          <p class="os-note">{i.note}</p>
        </section>
      ))
    }
  </div>

  <section class="next" aria-labelledby="ensuite">
    <h2 id="ensuite">Ensuite</h2>
    <ol class="steps">
      <li><div>Au premier lancement, choisis le dossier où ranger tes projets.</div></li>
      <li><div>Connecte-toi avec ton <a href="/compte/">compte DS-Studio</a> dans Réglages → Compte.</div></li>
      <li><div>Crée un projet vierge ou depuis l’adresse d’un site.</div></li>
      <li><div>Pour Figma, suis <a href="/plugin-figma/">l’installation du plugin</a>.</div></li>
    </ol>
  </section>
</Base>

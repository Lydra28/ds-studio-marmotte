---
import Base from '../layouts/Base.astro';
import HeroMotion from '../components/HeroMotion.astro';
import Playground from '../components/Playground.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { DOWNLOADS, INSTALLERS, euros, loadCatalog } from '../lib/site';

// Reste de l'accueil (cadrage/2026-11-14-cadrage-site.md, lot 3) : ce que
// fait l'app pour chaque métier, puis téléchargement et abonnement, en
// petites sections distinctes (retour de Romain du 2026-11-14 : boutons par
// système avec leur logo, compte retiré). Fonctionnalités réelles seulement ;
// montants lus dans le catalogue, comme la page Prix.
const c = await loadCatalog();
const design = [
  { title: 'La planche', text: 'Primitives, tokens sémantiques et typographie par mode, avec un aperçu qui suit chaque brouillon.' },
  { title: 'Les règles', text: 'Multiples de 4, contraste, taille de texte, nommage : les écarts sont signalés et corrigés en un clic.' },
  { title: 'Figma', text: 'Le plugin écrit la version acceptée dans les variables Figma et renvoie les composants à l’atelier.' },
  { title: 'Lenny et le Mur des DA', text: 'Lenny propose des brouillons ; le Mur génère des directions artistiques à partir d’inspirations.' },
];
const code = [
  { title: 'Depuis l’existant', text: 'Partir de l’adresse d’un site public, ou d’un dépôt GitHub en Pro : DS-Studio relève couleurs, polices et tailles, et propose un premier jeu.' },
  { title: 'Diff et versions', text: 'Rien n’est écrit sans accord : chaque changement passe par un diff, Comparer montre l’avant et l’après.' },
  { title: 'Export', text: 'CSS, Tailwind v4 ou JSON, à copier ou à télécharger.' },
  { title: 'Pull request', text: 'En Pro, la version acceptée part en pull request sur le dépôt : les valeurs en dur deviennent des tokens.' },
];
---

<Base title="DS-Studio">
  <div class="hero">
    <div>
      <h1>Le design system,<br />de Figma au code.</h1>
      <p class="lead">
        Designers et développeurs partagent les mêmes tokens : modifiés dans DS-Studio, comparés, puis envoyés dans Figma
        et dans le code.
      </p>
      <div class="actions">
        <a class="button primary" href="/telecharger/">Télécharger l’app</a>
        <a class="button" href="/prix/">Voir les prix</a>
      </div>
    </div>
    <HeroMotion />
  </div>

  <Playground />

  <section class="roles" aria-labelledby="metiers">
    <h2 id="metiers">Un atelier, deux métiers.</h2>
    <p class="roles-lead">
      Le designer règle les tokens, le développeur les reçoit dans son code. Entre les deux, une seule source et un diff à
      chaque changement.
    </p>
    <div class="roles-cols">
      <div>
        <div class="roles-head">
          <PixelIcon name="design" scale={3} />
          <h3>Côté design</h3>
        </div>
        <dl class="roles-list">
          {
            design.map((f) => (
              <div>
                <dt>{f.title}</dt>
                <dd>{f.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <div class="roles-head">
          <PixelIcon name="code" scale={3} />
          <h3>Côté code</h3>
        </div>
        <dl class="roles-list">
          {
            code.map((f) => (
              <div>
                <dt>{f.title}</dt>
                <dd>{f.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="get" aria-labelledby="telecharger">
    <h2 id="telecharger">Télécharger DS-Studio</h2>
    <p class="muted">Gratuit, installé sur le poste. Mises à jour automatiques sur Windows et Linux.</p>
    <div class="get-os">
      {
        INSTALLERS.map((i) => (
          <a class="button get-button" href={`${DOWNLOADS}/${i.file}`} download aria-label={`Télécharger pour ${i.os}`}>
            <PixelIcon name={i.icon} />
            <span>{i.os}</span>
          </a>
        ))
      }
    </div>
    <p class="get-note">
      macOS : Mac à puce Apple seulement. Premier lancement d’une app pas encore signée :
      <a href="/telecharger/">les étapes par système</a>.
    </p>
  </section>

  <section class="pro" aria-labelledby="abonnement">
    <div>
      <h2 id="abonnement">Passer Pro</h2>
      <p class="muted">
        {euros(c.pro.includedCents)} d’usage de l’assistant et du Mur inclus chaque mois, GitHub et ses pull requests. Sans
        engagement.
      </p>
    </div>
    <div class="pro-cta">
      <p class="pro-price">{euros(c.pro.amountCents)} <span>/ mois</span></p>
      <a class="button primary" href="/compte/">Passer Pro</a>
    </div>
  </section>

  <section class="local" aria-labelledby="poste">
    <div class="local-head">
      <h2 id="poste">Les projets restent sur le poste.</h2>
      <p class="muted">
        DS-Studio travaille en local. Son serveur ne garde que ce qui sert au compte et à la facturation.
      </p>
    </div>
    <div class="local-cols">
      <div class="local-col local-col--here">
        <span class="local-icon"><PixelIcon name="poste" scale={3} /></span>
        <h3>Sur le poste</h3>
        <ul>
          <li>Projets, tokens et versions</li>
          <li>Conversations avec l’assistant</li>
          <li>Captures du Mur des DA</li>
        </ul>
      </div>
      <div class="local-col">
        <span class="local-icon"><PixelIcon name="serveur" scale={3} /></span>
        <h3>Sur le serveur DS-Studio</h3>
        <ul>
          <li>Compte et abonnement</li>
          <li>Solde de crédits</li>
          <li>Coût des générations</li>
        </ul>
      </div>
    </div>
    <p class="local-note">
      Les demandes à l’assistant et au Mur, et sur confirmation des extraits de code ou une sélection Figma, passent par le
      serveur pour joindre le modèle d’IA, sans y être gardées. Détail dans la <a href="/confidentialite/">politique de confidentialité</a>.
    </p>
  </section>
</Base>

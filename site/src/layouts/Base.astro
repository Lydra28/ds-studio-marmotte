---
import '../styles/site.css';
import icon from '../../../desktop/logo-small.png';
import { loadCatalog } from '../lib/site';
import PixelIcon from '../components/PixelIcon.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'DS-Studio : l’atelier de design system installé sur le poste. Tokens, aperçu en direct, versions, Figma.' } =
  Astro.props;
const catalog = await loadCatalog();
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/telecharger/', label: 'Télécharger' },
  { href: '/plugin-figma/', label: 'Plugin Figma' },
  { href: '/prix/', label: 'Prix' },
  { href: '/compte/', label: 'Compte' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'DS-Studio' ? title : `${title} · DS-Studio`}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Geist+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    {
      catalog.mode !== 'live' && (
        <p class="banner" role="note">
          Paiements en mode test : aucune carte réelle n’est débitée pour l’instant.
        </p>
      )
    }
    <header class="top">
      <a class="brand" href="/">
        <img src={icon.src} width="32" height="32" alt="" />
        <span>DS-Studio</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation">
        <PixelIcon name="menu" />
        <span>Menu</span>
      </button>
      <nav id="navigation" aria-label="Navigation principale">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="foot">
      {/* Requins en transparence (scripts/ocean.ts) et logo : demande de Romain du 2026-11-15, sans Lenny. */}
      <canvas class="foot-ocean" aria-hidden="true"></canvas>
      <div class="foot-main">
        <div class="foot-brand">
          <a class="brand" href="/">
            <img src={icon.src} width="32" height="32" alt="" />
            <span>DS-Studio</span>
          </a>
          <p>Le design system, de Figma au code.</p>
          <a class="button primary" href="/telecharger/">Télécharger l’app</a>
        </div>
        <nav class="foot-nav" aria-label="Pied de page">
          <div>
            <p class="foot-h" id="pied-produit">Produit</p>
            <ul aria-labelledby="pied-produit">
              <li><a href="/telecharger/">Télécharger</a></li>
              <li><a href="/plugin-figma/">Plugin Figma</a></li>
              <li><a href="/prix/">Prix</a></li>
            </ul>
          </div>
          <div>
            <p class="foot-h" id="pied-compte">Compte</p>
            <ul aria-labelledby="pied-compte">
              <li><a href="/compte/">Compte</a></li>
              <li><a href="/compte/#retractation">Se rétracter</a></li>
            </ul>
          </div>
          <div>
            <p class="foot-h" id="pied-legal">Légal</p>
            <ul aria-labelledby="pied-legal">
              <li><a href="/mentions-legales/">Mentions légales</a></li>
              <li><a href="/cgv/">Conditions de vente</a></li>
              <li><a href="/confidentialite/">Confidentialité</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="foot-base">
        <p>© {new Date().getFullYear()} DS-Studio</p>
        <p>Les projets restent sur le poste.</p>
      </div>
    </footer>
    <script>
      import '../scripts/menu.ts';
      import '../scripts/ocean.ts';
    </script>
  </body>
</html>

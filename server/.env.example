# Serveur DS-Studio : copier en server/.env pour le développement local
# (gitignoré). En production, Render fournit ces variables ; rien dans le dépôt.

# Postgres : URL Render, ou `memory` pour une base PGlite en mémoire (dev).
DATABASE_URL=memory
# TLS vers Postgres : `require` (défaut hors local) ou `off` (URL interne Render, local).
DATABASE_SSL=
# Port d'écoute (Render le fournit).
PORT=8787
# URL publique du serveur, pour les liens des mails (défaut : http://127.0.0.1:PORT).
API_PUBLIC_URL=
# Domaine du cookie de session du site (.design-system-studio.fr) ; vide en local.
COOKIE_DOMAIN=
# Resend : clé API et expéditeur. Sans clé, les mails s'écrivent dans la console.
RESEND_API_KEY=
MAIL_FROM=DS-Studio <no-reply@design-system-studio.fr>
# Sentry (erreurs), vide pour désactiver.
SENTRY_DSN=

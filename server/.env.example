# Serveur DS-Studio : copier en server/.env pour le développement local
# (gitignoré). En production, Render fournit ces variables ; rien dans le dépôt.

# Postgres : URL Render, ou `memory` pour une base PGlite en mémoire (dev).
DATABASE_URL=memory
# TLS vers Postgres : `require` (défaut hors local) ou `off` (URL interne Render, local).
DATABASE_SSL=
# Port d'écoute (Render le fournit).
PORT=8787
# URL publique du serveur, pour les liens des mails (défaut : http://127.0.0.1:PORT).
API_PUBLIC_URL=
# Domaine du cookie de session du site (.design-system-studio.fr) ; vide en local.
COOKIE_DOMAIN=
# Resend : clé API et expéditeur. Sans clé, les mails s'écrivent dans la console.
RESEND_API_KEY=
MAIL_FROM=DS-Studio <no-reply@design-system-studio.fr>
# Clé OpenRouter du serveur, dédiée et plafonnée côté OpenRouter : l'app
# n'a plus de clé, tout passe par /v1/relay. Vide : relais désactivé (503).
OPENROUTER_API_KEY=
# Clé privée Ed25519 (PEM PKCS8) qui signe les licences ; `npm run admin -- keys`
# en génère une paire. Sans elle, clé éphémère (développement). La clé publique
# correspondante va dans server/license-public.pem (suivie par git) ; le serveur
# refuse de démarrer si les deux ne correspondent pas.
LICENSE_PRIVATE_KEY=
# Sentry (erreurs inattendues), vide pour désactiver. SENTRY_TEST_EVENT=1 envoie
# un message au démarrage pour vérifier le branchement, puis se retire.
SENTRY_DSN=

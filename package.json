{
  "name": "ds-studio",
  "version": "2.1.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Starter pédagogique local pour explorer et faire évoluer un Design System.",
  "main": "desktop/main.mjs",
  "author": "Romain",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx app/server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx app/server/index.ts",
    "launcher": "node scripts/launcher.mjs",
    "test:launcher": "node --test tests/launcher.test.mjs",
    "qualify:desktop": "node scripts/qualify-desktop.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "scan": "node scripts/scan-public.mjs",
    "doctor": "node scripts/doctor.mjs",
    "qualify": "node scripts/qualify-local.mjs",
    "format": "prettier --write .",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "npm run build && node scripts/build-desktop.mjs && electron .",
    "dist": "npm run build && node scripts/build-desktop.mjs && electron-builder --publish never",
    "dist:win": "npm run build && node scripts/build-desktop.mjs && electron-builder --win --publish never",
    "dist:mac": "npm run build && node scripts/build-desktop.mjs && electron-builder --mac --publish never",
    "dist:linux": "npm run build && node scripts/build-desktop.mjs && electron-builder --linux --publish never",
    "test:desktop": "node scripts/build-desktop.mjs && playwright test --config tests/desktop/playwright.config.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.dsstudio.atelier",
    "productName": "DS-Studio",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "package.json",
      "desktop/main.mjs",
      "desktop/update-config.mjs",
      "desktop/icon.png",
      "desktop/build/**",
      "dist/**",
      "templates/**",
      "projects/marmotte/**",
      "!projects/marmotte/.ds-studio/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**",
      "!node_modules/zod/**"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://releases.ds-studio.invalid/stable",
      "channel": "stable"
    },
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "desktop/icon-512.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "DS-Studio-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "DS-Studio-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "desktop/icon-512.png",
      "artifactName": "DS-Studio-${version}-${arch}.AppImage"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DS-Studio",
      "artifactName": "DS-Studio-Setup-${version}.exe"
    }
  }
}
